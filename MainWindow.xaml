<Window x:Class="CampusNetTraffic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CampusNet Traffic" Height="760" Width="1180"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#162033" />
        <SolidColorBrush x:Key="Muted" Color="#6B7280" />
        <SolidColorBrush x:Key="Primary" Color="#2563EB" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#E6EAF2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAB2C0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="#C8D8FF" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,28">
                    <TextBlock Text="CampusNet" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="校园网流量助手" Foreground="#AAB2C0" FontSize="13" Margin="0,6,0,30" />

                    <Button x:Name="OverviewNavButton" Content="总览" Style="{StaticResource NavButton}" Click="OverviewNav_Click" />
                    <Button x:Name="LoginNavButton" Content="校园网登录" Style="{StaticResource NavButton}" Click="LoginNav_Click" />
                    <Button x:Name="DevicesNavButton" Content="在线设备" Style="{StaticResource NavButton}" Click="DevicesNav_Click" />
                    <Button x:Name="StatsNavButton" Content="历史统计" Style="{StaticResource NavButton}" Click="StatsNav_Click" />
                    <Button x:Name="SettingsNavButton" Content="设置" Style="{StaticResource NavButton}" Click="SettingsNav_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,24">
                    <TextBlock Text="低占用模式运行中" Foreground="#AAB2C0" FontSize="12" />
                    <TextBlock x:Name="StatusText" Text="等待校园网同步" Foreground="#D1D5DB" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <DockPanel Margin="0,0,0,22">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="PageTitleText" Text="流量总览" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="Bold" />
                        <TextBlock x:Name="PageSubtitleText" Text="本机实时监控 + CAUC Dr.COM 后台官方数据" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="网页登录" Style="{StaticResource GhostButton}" Click="OpenLogin_Click" Margin="0,0,10,0" />
                        <Button Content="同步校园网" Style="{StaticResource PrimaryButton}" Click="SyncCampus_Click" />
                    </StackPanel>
                </DockPanel>

                <StackPanel x:Name="OverviewPanel">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18" Background="#0F172A" BorderBrush="#0F172A">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本次使用流量" Foreground="#CBD5E1" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="HeroUsageText" Text="0 MB" Foreground="White" FontSize="48" FontWeight="Bold" Margin="0,6,0,0" />
                                <TextBlock x:Name="HeroHintText" Text="从本次打开 APP 开始统计，包含上传和下载" Foreground="#94A3B8" FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="实时下载 / 上传" Foreground="#CBD5E1" FontSize="13" HorizontalAlignment="Right" />
                                <TextBlock x:Name="HeroRateText" Text="0 KB/s  /  0 KB/s" Foreground="#BFDBFE" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,18">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock x:Name="DownloadSpeedText" Text="0 KB/s" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="实时下载" Style="{StaticResource MetricLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock x:Name="UploadSpeedText" Text="0 KB/s" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="实时上传" Style="{StaticResource MetricLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock x:Name="UsedTrafficText" Text="-" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="官方已用流量" Style="{StaticResource MetricLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="AvailableTrafficText" Text="-" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="官方可用流量" Style="{StaticResource MetricLabel}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="校园网账户" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="状态" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="AccountStatusText" Grid.Column="1" Text="-" Foreground="{StaticResource Ink}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="余额" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="BalanceText" Grid.Column="3" Text="-" Foreground="{StaticResource Ink}" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="1" Text="套餐" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="PlanText" Grid.Row="1" Grid.Column="1" Text="-" Foreground="{StaticResource Ink}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="计费方式" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="BillingModeText" Grid.Row="1" Grid.Column="3" Text="-" Foreground="{StaticResource Ink}" />

                                    <TextBlock Grid.Row="2" Text="计费周期" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="BillingPeriodText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="-" Foreground="{StaticResource Ink}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="本机采集" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="LocalTotalText" Text="本次运行：0 MB" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0" />
                                <TextBlock x:Name="LastSampleText" Text="等待采样" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Border x:Name="LoginPanel" Style="{StaticResource Card}" Height="480" Visibility="Collapsed" Margin="0,0,0,18">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="校园网网页登录" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" />
                            <Button Content="隐藏" Style="{StaticResource GhostButton}" DockPanel.Dock="Right" Click="HideBrowser_Click" />
                        </DockPanel>
                        <wv2:WebView2 x:Name="LoginWebView" />
                    </DockPanel>
                </Border>

                <Border x:Name="DevicesPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="在线设备" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <DataGrid x:Name="DeviceGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeight="36"
                                  Background="White"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="上线时间" Binding="{Binding LoginTime}" Width="170" />
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120" />
                                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150" />
                                <DataGridTextColumn Header="主机名" Binding="{Binding HostName}" Width="*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding TerminalType}" Width="90" />
                                <DataGridTextColumn Header="下载 MB" Binding="{Binding DownloadMb, StringFormat=F1}" Width="90" />
                                <DataGridTextColumn Header="在线时长" Binding="{Binding UseTime}" Width="120" />
                                <DataGridTemplateColumn Header="操作" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="注销"
                                                    Padding="10,4"
                                                    Style="{StaticResource GhostButton}"
                                                    Click="OfflineDevice_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="StatsPanel" Visibility="Collapsed">
                    <UniformGrid Columns="2" Rows="1" Margin="0,0,0,18">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock x:Name="TodayUsageText" Text="-" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="今日本机流量" Style="{StaticResource MetricLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="MonthUsageText" Text="-" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="本月本机流量" Style="{StaticResource MetricLabel}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="说明" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="今日和本月统计基于本机采样数据库，适合观察本机实际经过网卡的流量；官方流量以校园网后台为准。" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="SettingsPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="设置" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="当前版本已支持：会话过期前免重复登录、30 秒自动同步校园网、1 秒刷新本机网速。" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock Text="统计网卡" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" />
                        <ComboBox x:Name="NetworkAdapterComboBox"
                                  Width="420"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="NetworkAdapterComboBox_SelectionChanged"
                                  Margin="0,10,0,0" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="开机自动启动"
                                  Foreground="{StaticResource Ink}"
                                  FontSize="14"
                                  Margin="0,18,0,0"
                                  Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed" />
                        <CheckBox x:Name="MinimizeToTrayCheckBox"
                                  Content="关闭窗口时最小化到托盘"
                                  Foreground="{StaticResource Ink}"
                                  FontSize="14"
                                  IsChecked="True"
                                  Margin="0,10,0,0" />
                        <TextBlock Text="提醒阈值" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,0" />
                        <Grid Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="剩余流量低于" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox x:Name="AvailableThresholdGbTextBox" Grid.Column="1" Text="2" Padding="8,4" />
                            <TextBlock Grid.Column="2" Text="GB 时提醒" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />

                            <TextBlock Grid.Row="1" Text="余额低于" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox x:Name="BalanceThresholdTextBox" Grid.Row="1" Grid.Column="1" Text="5" Padding="8,4" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="元时提醒" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />

                            <TextBlock Grid.Row="2" Text="本次使用超过" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox x:Name="SessionThresholdGbTextBox" Grid.Row="2" Grid.Column="1" Text="5" Padding="8,4" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="GB 时提醒" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                        <Button Content="清除校园网登录状态" Style="{StaticResource GhostButton}" Click="ClearSession_Click" HorizontalAlignment="Left" Margin="0,18,0,0" />
                        <Button Content="导出诊断日志" Style="{StaticResource GhostButton}" Click="ExportLog_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
