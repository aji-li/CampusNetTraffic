[Version]
Signature="$WINDOWS NT$"
Class=NetService
ClassGuid={4D36E974-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
DriverVer=07/04/2026,1.1.0.0
CatalogFile=CampusNetTrafficNet.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=CampusNetTrafficNet,0x00000002,ServiceInstall

[DefaultUninstall.NTamd64.Services]
DelService=CampusNetTrafficNet,0x200

[DriverCopyFiles]
CampusNetTrafficNet.sys

[ServiceInstall]
DisplayName=%ServiceDisplayName%
Description=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\CampusNetTrafficNet.sys

[Strings]
ManufacturerName="CAUCNet Traffic"
ServiceDisplayName="CampusNetTraffic Network Counter Driver"
ServiceDescription="WFP byte counter driver for CAUCNet Traffic"
